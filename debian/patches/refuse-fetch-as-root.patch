+/// Refuse to run as root.
+///
+/// Fetching as root would leave root-owned files in the revocation cache
+/// that the unprivileged fetch service can then no longer update, so tell
+/// the user to start the dedicated service instead.
+#[cfg(all(feature = "__fetch", unix))]
+fn refuse_root() -> Result<(), Report> {
+    // SAFETY: geteuid is always safe to call.
+    if unsafe { libc::geteuid() } != 0 {
+        return Ok(());
+    }
+    Err(Report::msg(
+        "refusing to run as root; start `upki-fetch.service` instead",
+    ))
+}
+
+#[cfg(all(feature = "__fetch", not(unix)))]
+fn refuse_root() -> Result<(), Report> {
+    Ok(())
+}
+
